<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Minha Loja Online</title>
  <!-- Ativando o CSS -->
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>Bem-vindo à Loja de Exemplo</h1>
    <p>Este site é apenas uma demonstração</p>
  </header>

  <section class="produtos">
    <div class="produto">
      <h2>Camisa</h2>
      <p>R$ 50,00</p>
      <button onclick="comprarProduto('Camisa', 50)">Comprar</button>
    </div>

    <div class="produto">
      <h2>Calça</h2>
      <p>R$ 80,00</p>
      <button onclick="comprarProduto('Calça', 80)">Comprar</button>
    </div>

    <div class="produto">
      <h2>Tênis</h2>
      <p>R$ 120,00</p>
      <button onclick="comprarProduto('Tênis', 120)">Comprar</button>
    </div>
  </section>

  <section class="carrinho">
    <h2>Carrinho de Compras</h2>
    <ul id="lista-carrinho"></ul>
    <p>Total: R$ <span id="total">0</span></p>
  </section>

  <!-- Ativando o JS -->
  <script src="script.js"></script>
</body>
</html>

 
/* Estilo geral */
body {
  font-family: Arial, sans-serif;
  margin: 20px;
  background-color: #f0f0f5; /* cinza claro com leve tom lilás */
}

header {
  text-align: center;
  margin-bottom: 30px;
  color: #4b0082; /* roxo escuro */
}

.produtos {
  display: flex;
  gap: 20px;
  justify-content: center;
}

.produto {
  background: white;
  padding: 15px;
  border: 2px solid #d8bfd8; /* lilás suave */
  border-radius: 8px;
  text-align: center;
}

/* Botões */
button {
  margin-top: 10px;
  padding: 8px 12px;
  background: #6a5acd; /* roxo médio */
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}


/* Laranja quando passa o mouse */
button:hover {
  background: #ff8c00; /* laranja escuro */
}

/* Vermelho queimado quando clica */
button:active {
  background: #b22222; /* vermelho escuro */
}

/* Carrinho */
.carrinho {
  margin-top: 40px;
  text-align: center;
  color: #4b0082; /* roxo escuro */
}

.carrinho ul {
  list-style: none;
  padding: 0;
}

.carrinho li {
  margin: 5px 0;
}


// Lista apenas para simulação
let carrinho = [];

// Função de "compra" simulada
function comprarProduto(produto, preco) {
  // Adiciona ao carrinho fictício
  carrinho.push({ nome: produto, valor: preco });

  // Mostra mensagem de demonstração
  alert("Você adicionou " + produto + " (R$ " + preco + ") ao carrinho.\nEste site é apenas uma demonstração, não é possível finalizar a compra.");
  
  atualizarCarrinho();
}

// Atualiza carrinho na tela (só visual)
function atualizarCarrinho() {
  const lista = document.getElementById("lista-carrinho");
  lista.innerHTML = "";

  let total = 0;
  carrinho.forEach((item) => {
    total += item.valor;
    const li = document.createElement("li");
    li.textContent = `${item.nome} - R$ ${item.valor}`;
    lista.appendChild(li);
  });

  document.getElementById("total").textContent = total;
}
